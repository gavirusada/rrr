<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#11151E"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎥 Gaviru Cam Pro Studio"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGuide"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="📖 Help"
                android:textSize="11sp"
                android:textColor="#F8FAFC"
                android:backgroundTint="#2563EB"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⚙️ Room"
                android:textSize="11sp"
                android:textColor="#F8FAFC"
                android:backgroundTint="#334155"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#251010"
                android:textColor="#FCA5A5"
                android:text="Standby"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Mode Selector: Phone Camera vs Canon DSLR -->
        <LinearLayout
            android:id="@+id/modeSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnModePhone"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📱 Phone Camera"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeCanon"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📷 Canon DSLR Wi-Fi"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:backgroundTint="#1E293B"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtDiagInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode: Phone Camera | Room: gaviru-cam-pro | Ready to Stream"
            android:textColor="#A7F3D0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="3"
            android:ellipsize="start"
            android:background="#0A0E17"
            android:padding="4dp"
            android:layout_marginTop="5dp" />

    </LinearLayout>

    <!-- Center Camera Live Viewport -->
    <FrameLayout
        android:id="@+id/viewportFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomControls"
        android:background="#000000">

        <!-- Interactive Fullscreen WebView for VDO.Ninja Streaming (Kept VISIBLE for 30FPS background WebRTC) -->
        <WebView
            android:id="@+id/vdoWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Native Hardware-Accelerated 0-Latency Canon Live View Viewport (Sits on top in Canon Mode) -->
        <ImageView
            android:id="@+id/imgLiveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="#000000"
            android:visibility="gone" />

        <!-- Tap-To-Focus Indicator Box -->
        <View
            android:id="@+id/focusBox"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/focus_rect"
            android:visibility="gone" />

        <!-- Canon Waiting Overlay -->
        <LinearLayout
            android:id="@+id/waitingOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtWaitingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Canon කැමරාවට connect වෙමින් පවතී...\n\nකැමරාවේ Wi-Fi Menu එකෙන් 'Remote control (EOS Utility)' 💻 තෝරන්න.\nCamera Mode Dial එක M / P වලට දමා තබන්න."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Camera Controls -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#111520"
        android:padding="8dp">

        <!-- Phone Camera Mode Controls -->
        <LinearLayout
            android:id="@+id/phoneControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnStreamPhoneObs"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.4"
                    android:text="🚀 Start Phone Cam Stream"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#10B981"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnFlipPhoneCam"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:text="🔄 Flip Cam"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#475569" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCopyPhoneObsLink"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="📋 Copy OBS Link"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D97706"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnPhoneQuality"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="⚡ 1080p / 4K 60FPS"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E293B" />

            </LinearLayout>

        </LinearLayout>

        <!-- Canon DSLR Mode Controls -->
        <LinearLayout
            android:id="@+id/canonControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Shutter Button & OBS Stream Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnShutter"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="📸 Take Photo (Shutter)"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#DC2626"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnStreamObs"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="🚀 Stream Canon ➔ OBS"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#10B981" />

            </LinearLayout>

            <!-- Toggle View & Copy Link Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnToggleVdoView"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="🌐 Show VDO.Ninja Screen"
                    android:textSize="11.5sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnCopyCanonObsLink"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="📋 Copy OBS Links"
                    android:textSize="11.5sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D97706" />

            </LinearLayout>

            <!-- Focus Drive Control Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFar3"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="⏪ Far 3"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E293B"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnFar1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="◀ Far 1"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E293B"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnNear1"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Near 1 ▶"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E293B"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnNear3"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Near 3 ⏩"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E293B" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
