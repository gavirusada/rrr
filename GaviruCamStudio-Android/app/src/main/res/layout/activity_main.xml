<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F">

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#11151E"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎥 Gaviru Cam Pro Studio"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⚙️ IP"
                android:textSize="11sp"
                android:textColor="#F8FAFC"
                android:backgroundTint="#334155"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#251010"
                android:textColor="#FCA5A5"
                android:text="Connecting..."
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtDiagInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera IP: 192.168.1.1:15740 | Initializing..."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Center Camera Live Viewport -->
    <FrameLayout
        android:id="@+id/viewportFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomControls"
        android:background="#000000">

        <!-- Native Hardware-Accelerated 0-Latency Canon Live View Viewport -->
        <ImageView
            android:id="@+id/imgLiveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <!-- Tap-To-Focus Indicator Box -->
        <View
            android:id="@+id/focusBox"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/focus_rect"
            android:visibility="gone" />

        <!-- Waiting Message -->
        <LinearLayout
            android:id="@+id/waitingOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtWaitingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Connecting to Canon Camera...\nMake sure Camera Mode Dial is in M or P"
                android:textColor="#CBD5E1"
                android:textSize="12.5sp"
                android:gravity="center"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Hidden WebView for VDO.Ninja Background Broadcasting -->
        <WebView
            android:id="@+id/vdoWebView"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible" />

    </FrameLayout>

    <!-- Bottom Camera Controls -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#111520"
        android:padding="8dp">

        <!-- Shutter Button & OBS Stream Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnShutter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📸 Take Photo (Shutter)"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DC2626"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnStreamObs"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="🚀 Stream Canon ➔ OBS"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981" />

        </LinearLayout>

        <!-- Focus Drive Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFar3"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="⏪ Far 3"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnFar1"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="◀ Far 1"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnNear1"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Near 1 ▶"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnNear3"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Near 3 ⏩"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E293B" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
